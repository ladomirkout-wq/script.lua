local function copyToClipboard(text)
	return pcall(function()
		if setclipboard then
			setclipboard(text)
		elseif toclipboard then
			toclipboard(text)
		else
			error("No clipboard function available")
		end
	end)
end

local function getRanks(player)
	if rankCache[player] then return rankCache[player] end

	local result = { cake = "Guest", coherent = "Guest", ub = "Guest", hb = "Guest", t2a = "Guest" }
	local remaining = 5

	task.spawn(function()
		pcall(function() result.cake = player:GetRoleInGroup(cakeGroupId) end)
		remaining -= 1
	end)

	task.spawn(function()
		pcall(function() result.coherent = player:GetRoleInGroup(coherentGroupId) end)
		remaining -= 1
	end)

	task.spawn(function()
		pcall(function() result.ub = player:GetRoleInGroup(ubGroupId) end)
		remaining -= 1
	end)

	task.spawn(function()
		pcall(function() result.hb = player:GetRoleInGroup(hbGroupId) end)
		remaining -= 1
	end)

	task.spawn(function()
		pcall(function() result.t2a = player:GetRoleInGroup(t2aGroupId) end)
		remaining -= 1
	end)

	local startTime = tick()
	while remaining > 0 and tick() - startTime < 8 do
		task.wait()
	end

	rankCache[player] = result
	return result
end

