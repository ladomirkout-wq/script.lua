local function escapeXml(s)
	s = s:gsub("&", "&amp;")
	s = s:gsub("<", "&lt;")
	s = s:gsub(">", "&gt;")
	return s
end

local function getEntriesForPlayer(player)
	local ranks = getRanks(player)
	local entries = {}

	local cakeTag, cakeColor, cakeRainbow = resolveCakeTag(ranks.cake)
	if cakeTag then
		table.insert(entries, { rank = cakeTag, color = cakeColor, rainbow = cakeRainbow, group = cakeGroupName })
	end

	local cohTag, cohColor = resolveCoherentTag(ranks.coherent)
	if cohTag then
		table.insert(entries, { rank = cohTag, color = cohColor, rainbow = false, group = coherentGroupName })
	end

	local ubTag, ubColor = resolveUbTag(ranks.ub)
	if ubTag then
		table.insert(entries, { rank = ubTag, color = ubColor, rainbow = false, group = ubGroupName })
	end

	local hbTag, hbColor = resolveHbTag(ranks.hb)
	if hbTag then
		table.insert(entries, { rank = hbTag, color = hbColor, rainbow = false, group = hbGroupName })
	end

	local t2aTag, t2aColor = resolveT2aTag(ranks.t2a)
	if t2aTag then
		table.insert(entries, { rank = t2aTag, color = t2aColor, rainbow = false, group = t2aGroupName })
	end

	return entries
end

local function createNametag(player)
	local character = player.Character
	if not character then return end

	local head = character:WaitForChild("Head", 5)
	if not head then return end

	if head:FindFirstChild("GroupRankTag") then
		head.GroupRankTag:Destroy()
	end

	local entries = getEntriesForPlayer(player)

	if #entries == 0 then
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GroupRankTag"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 260, 0, 60 + #entries * 34)
	billboard.StudsOffset = Vector3.new(0, 8 + #entries * 0.6, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = chatRange
	billboard.Parent = head

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextStrokeTransparency = 0.35
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 20
	textLabel.TextScaled = false
	textLabel.TextWrapped = true
	textLabel.RichText = true
	textLabel.Parent = billboard

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			if billboard and billboard.Parent then
				billboard.Enabled = false
			end
		end)
	end

	local anyRainbow = false
	for _, e in ipairs(entries) do
		if e.rainbow then anyRainbow = true break end
	end

	local function renderText(rainbowColor)
		local parts = {}
		for _, entry in ipairs(entries) do
			local c = entry.color
			if entry.rainbow and rainbowColor then c = rainbowColor end
			local hex = string.format("#%02X%02X%02X",
				math.floor(c.R * 255 + 0.5),
				math.floor(c.G * 255 + 0.5),
				math.floor(c.B * 255 + 0.5))

			table.insert(parts, string.format(
				'<font size="20" color="%s">%s</font>',
				hex, escapeXml(entry.rank)))

			if entry.group ~= "" then
				table.insert(parts, string.format(
					'<font size="11" color="#B0B0B0">%s</font>',
					escapeXml(entry.group)))
			end
		end
		textLabel.Text = table.concat(parts, "\n")
	end

	renderText(nil)

	if anyRainbow then
		task.spawn(function()
			while billboard and billboard:IsDescendantOf(game) do
				renderText(Color3.fromHSV(tick() % 5 / 5, 1, 1))
				RunService.Heartbeat:Wait()
			end
		end)
	end

	activeTags[billboard] = true
	billboard.Destroying:Connect(function()
		activeTags[billboard] = nil
	end)
end

local function onPlayerAdded(player)
	if player.Character then
		task.spawn(createNametag, player)
	else
		player.CharacterAdded:Once(function()
			task.spawn(createNametag, player)
		end)
	end

	player.CharacterAdded:Connect(function()
		task.spawn(createNametag, player)
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

