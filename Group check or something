local function resolveCakeTag(rank)
	if rank == "Cake Creator" then
		return "Cake Creator", Color3.fromRGB(255, 255, 255), true
	elseif rank == "Cake Manager" then
		return "Cake Manager", Color3.fromRGB(255, 170, 40), false
	elseif rank == "Cake Moderator" then
		return "Cake Moderator", Color3.fromRGB(255, 230, 60), false
	elseif rank == "Guest" or rank == "" then
		return nil, nil, false
	else
		return "Cake Member", Color3.fromRGB(80, 255, 180), false
	end
end

local function resolveCoherentTag(rank)
	if rank == "Guest" or rank == "" then
		return nil, nil
	end
	return rank, Color3.fromRGB(120, 190, 255)
end

